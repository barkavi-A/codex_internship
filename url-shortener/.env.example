# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/url_shortener_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=url_user
DB_PASSWORD=url_password

# JWT Security (Must be at least 32 characters long)
JWT_SECRET=super-secret-jwt-key-for-url-shortener-service-2026-min-256-bits

# Server & Application Configuration
BASE_URL=http://localhost:8080
SERVER_PORT=8080
IP_HASH_SALT=default-ip-hash-salt-value-for-privacy-protection
